NEXT_PUBLIC_SITE_URL=https://opalo.me
NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY also works
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only, never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=
VISITOR_HASH_SECRET=
# stripe | mercadopago | wompi | paypal
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
# contact form (/contacto) — sender domain must be verified in Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Ópalo <contacto@opalo.me>"
# Wompi: PAYMENT_PROVIDER=wompi
#   PAYMENT_PUBLIC_KEY      pub_test_… / pub_prod_…
#   PAYMENT_SECRET_KEY      integrity secret (test_integrity_… / prod_integrity_…)
#   PAYMENT_WEBHOOK_SECRET  events secret (test_events_… / prod_events_…)
PAYMENT_PUBLIC_KEY=
# Premium price in Colombian pesos (Wompi charges COP); default 40000
PREMIUM_PRICE_COP=40000
